class Solution {
  public:
    int revnum(int n , int rev=0){
        
        if(n==0) return rev;
        else 
        return revnum(n/10 , rev*10+(n%10));
    }
    int power(int base, int e){
        if(e==0) return 1;
        else 
        return(base*power(base,e-1));
        
    }
  
    int reverseExponentiation(int n) {
        int rev = revnum(n);
        return power(n,rev);
    }
};